<mxfile host="app.diagrams.net" scale="1" border="20">
  <diagram id="state-study-application" name="state-study-application">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 初期擬似状態 -->
        <mxCell id="init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="195" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- 状態 -->
        <mxCell id="s-applied" value="申込済" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="120" y="180" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s-confirmed" value="確定" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s-waiting" value="キャンセル待ち" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="420" y="300" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s-cancelled" value="キャンセル" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="800" y="200" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- 終了状態 -->
        <mxCell id="final" value="" style="shape=endState;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1010" y="210" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- 遷移 -->
        <mxCell id="e-init" value="申込" style="edgeStyle=none;html=1;endArrow=open;endFill=0;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="init" target="s-applied">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-approve-ok" value="主催者が承認 [定員内]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-applied" target="s-confirmed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="105" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-approve-full" value="主催者が承認 [定員超過]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-applied" target="s-waiting">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="225" y="325" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-promote" value="確定者のキャンセル / 繰り上げ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-waiting" target="s-confirmed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cancel-confirmed" value="社員がキャンセル [開催日の前日まで]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-confirmed" target="s-cancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="105" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-cancel-waiting" value="社員がキャンセル [開催日の前日まで]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-waiting" target="s-cancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="830" y="325" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-cancel-applied" value="社員がキャンセル [開催日の前日まで]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-applied" target="s-cancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="155" y="430" />
              <mxPoint x="890" y="430" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-final" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;strokeColor=#000000;" edge="1" parent="1" source="s-cancelled" target="final">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
