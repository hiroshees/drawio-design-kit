<mxfile host="app.diagrams.net" scale="1" border="20">
  <diagram id="usecase-library-test" name="usecase-library-test">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- システムの枠（枠そのものにシステム名・上寄せ） -->
        <mxCell id="system" value="図書貸出システム" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="480" height="360" as="geometry" />
        </mxCell>

        <!-- アクター（枠の外） -->
        <mxCell id="actor-user" value="利用者" style="shape=umlActor;verticalLabelPosition=middle;labelPosition=left;verticalAlign=middle;align=right;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="actor-admin" value="管理者" style="shape=umlActor;verticalLabelPosition=middle;labelPosition=right;verticalAlign=middle;align=left;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="800" y="290" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- ユースケース -->
        <mxCell id="uc-search" value="本を検索する" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="270" y="80" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc-borrow" value="本を借りる" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="270" y="180" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc-login" value="ログインする" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="520" y="180" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc-register" value="本を登録する" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="520" y="300" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- 関連（矢印なしの実線） -->
        <mxCell id="a1" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="actor-user" target="uc-search">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="actor-user" target="uc-borrow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="actor-admin" target="uc-register">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- include（基本 → 部品、点線＋開いた矢印） -->
        <mxCell id="i1" value="«include»" style="dashed=1;endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="uc-borrow" target="uc-login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
