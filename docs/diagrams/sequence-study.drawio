<mxfile host="app.diagrams.net" scale="1" border="20">
  <diagram id="sequence-study" name="sequence-study">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ライフライン -->
        <mxCell id="ll-emp" value="社員" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=42;outlineConnect=0;size=40;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="40" height="560" as="geometry" />
        </mxCell>
        <mxCell id="ll-scr" value=":申込画面" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="120" height="560" as="geometry" />
        </mxCell>
        <mxCell id="ll-study" value=":勉強会" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="460" y="40" width="120" height="560" as="geometry" />
        </mxCell>
        <mxCell id="ll-app" value=":申込" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="790" y="40" width="100" height="560" as="geometry" />
        </mxCell>

        <!-- 活性区間 -->
        <mxCell id="act-emp" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="90" y="110" width="20" height="370" as="geometry" />
        </mxCell>
        <mxCell id="act-scr" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="290" y="120" width="20" height="360" as="geometry" />
        </mxCell>
        <mxCell id="act-study" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="510" y="150" width="20" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act-app1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="830" y="230" width="20" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act-app2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="830" y="380" width="20" height="60" as="geometry" />
        </mxCell>

        <!-- alt の区切り（点線）とガード条件 -->
        <mxCell id="alt-sep" value="" style="line;strokeWidth=1;dashed=1;html=1;strokeColor=#000000;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="346" width="880" height="8" as="geometry" />
        </mxCell>
        <mxCell id="alt-g1" value="[空きあり]" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="215" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="alt-g2" value="[満員]" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="358" width="100" height="20" as="geometry" />
        </mxCell>

        <!-- メッセージ（活性区間に連結せず、座標で両端を活性区間の端にそろえる） -->
        <!-- 1. 社員 → 申込画面：申し込む(勉強会ID) -->
        <mxCell id="m1" value="申し込む(勉強会ID)" style="html=1;rounded=0;endArrow=block;endFill=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="120" as="sourcePoint" />
            <mxPoint x="290" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- 2. 申込画面 → 勉強会：空きがあるか() -->
        <mxCell id="m2" value="空きがあるか()" style="html=1;rounded=0;endArrow=block;endFill=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="160" as="sourcePoint" />
            <mxPoint x="510" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- 3. 勉強会 → 申込画面：true / false（戻り値） -->
        <mxCell id="m3" value="true / false" style="html=1;rounded=0;dashed=1;endArrow=open;endFill=0;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="200" as="sourcePoint" />
            <mxPoint x="310" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- alt [空きあり] -->
        <mxCell id="m4" value="作成する(社員, 勉強会)" style="html=1;rounded=0;endArrow=block;endFill=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint x="310" y="240" as="sourcePoint" />
            <mxPoint x="830" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="申込" style="html=1;rounded=0;dashed=1;endArrow=open;endFill=0;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry x="-0.5" relative="1" as="geometry">
            <mxPoint x="830" y="280" as="sourcePoint" />
            <mxPoint x="310" y="280" as="targetPoint" />
