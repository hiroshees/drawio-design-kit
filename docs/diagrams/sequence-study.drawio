        <mxCell id="m6" value="参加確定を表示" style="html=1;rounded=0;dashed=1;endArrow=open;endFill=0;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="320" as="sourcePoint" />
            <mxPoint x="110" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- alt [満員] -->
        <mxCell id="m7" value="作成する(社員, 勉強会, キャンセル待ち)" style="html=1;rounded=0;endArrow=block;endFill=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint x="310" y="390" as="sourcePoint" />
            <mxPoint x="830" y="390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="申込" style="html=1;rounded=0;dashed=1;endArrow=open;endFill=0;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry x="-0.5" relative="1" as="geometry">
            <mxPoint x="830" y="430" as="sourcePoint" />
            <mxPoint x="310" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="キャンセル待ちを表示" style="html=1;rounded=0;dashed=1;endArrow=open;endFill=0;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="470" as="sourcePoint" />
            <mxPoint x="110" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- alt の枠（最前面・塗りつぶしなし） -->
        <mxCell id="alt" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=60;height=25;fillColor=#FFFFFF;swimlaneFillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="880" height="290" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
