        <mxCell id="ll-repo" value=":申込リポジトリ" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="700" y="40" width="120" height="580" as="geometry" />
        </mxCell>

        <!-- 活性区間 -->
        <mxCell id="act-emp" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="90" y="110" width="20" height="460" as="geometry" />
        </mxCell>
        <mxCell id="act-scr" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="290" y="120" width="20" height="450" as="geometry" />
        </mxCell>
        <mxCell id="act-svc" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="510" y="150" width="20" height="380" as="geometry" />
        </mxCell>
        <mxCell id="act-repo1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="750" y="190" width="20" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act-repo2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="750" y="310" width="20" height="60" as="geometry" />
        </mxCell>

        <!-- alt の区切り（点線）とガード条件 -->
        <mxCell id="alt-sep" value="" style="line;strokeWidth=1;dashed=1;html=1;strokeColor=#000000;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="466" width="780" height="8" as="geometry" />
        </mxCell>
        <mxCell id="alt-g1" value="[開催日の前日まで]" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="272" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="alt-g2" value="[開催日の前日を過ぎている]" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="478" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- メッセージ（活性区間に連結せず、座標で両端を活性区間の端にそろえる） -->
        <!-- 1. 社員 → 画面：キャンセルする(申込ID) -->
        <mxCell id="m1" value="キャンセルする(申込ID)" style="html=1;rounded=0;endArrow=block;endFill=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="120" as="sourcePoint" />
            <mxPoint x="290" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- 2. 画面 → 申込サービス：キャンセルする(申込ID) -->
        <mxCell id="m2" value="キャンセルする(申込ID)" style="html=1;rounded=0;endArrow=block;endFill=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="160" as="sourcePoint" />
            <mxPoint x="510" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- 3. 申込サービス → 申込リポジトリ：取得する(申込ID) -->
        <mxCell id="m3" value="取得する(申込ID)" style="html=1;rounded=0;endArrow=block;endFill=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="200" as="sourcePoint" />
            <mxPoint x="750" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- 4. 申込リポジトリ → 申込サービス：申込（開催日を含む）（戻り値） -->
        <mxCell id="m4" value="申込(開催日を含む)" style="html=1;rounded=0;dashed=1;endArrow=open;endFill=0;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="240" as="sourcePoint" />
            <mxPoint x="530" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- alt [開催日の前日まで] -->
        <mxCell id="m5" value="削除する(申込)" style="html=1;rounded=0;endArrow=block;endFill=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="320" as="sourcePoint" />
            <mxPoint x="750" y="320" as="targetPoint" />
