<mxfile host="app.diagrams.net" scale="1" border="20">
  <diagram id="activity-ai" name="activity-ai">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- レーン（担当） -->
        <mxCell id="lane-org" value="主催者" style="swimlane;html=1;startSize=30;horizontal=1;fontStyle=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="820" as="geometry" />
        </mxCell>
        <mxCell id="lane-sys" value="システム" style="swimlane;html=1;startSize=30;horizontal=1;fontStyle=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="460" height="820" as="geometry" />
        </mxCell>

        <!-- 開始 -->
        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="175" y="100" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- アクション（角丸の四角） -->
        <mxCell id="act-input" value="勉強会の内容を入力する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="110" y="160" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act-check" value="入力内容をチェックする" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="470" y="260" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act-fix" value="入力内容を修正する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="110" y="370" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act-register" value="勉強会を登録する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="470" y="480" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act-mail" value="社員に告知メールを送る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="360" y="640" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act-cal" value="社内カレンダーに登録する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="580" y="640" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- 判断（ひし形） -->
        <mxCell id="decision" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="520" y="370" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- フォーク／ジョイン（黒い横棒） -->
        <mxCell id="fork" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="410" y="590" width="280" height="10" as="geometry" />
        </mxCell>
        <mxCell id="join" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="410" y="750" width="280" height="10" as="geometry" />
        </mxCell>

        <!-- 終了（二重丸） -->
        <mxCell id="end" value="" style="shape=endState;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="535" y="800" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- 制御フロー -->
        <mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="act-input">
